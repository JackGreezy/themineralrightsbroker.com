<script src="https://unpkg.com/swiper@8/swiper-bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {

  Webflow.push(function () {


    const sliderEl = document.querySelector('.swiper.is-hardware');
    if (!sliderEl) return;

    const Hardware = new Swiper(sliderEl, {
      slidesPerView: "auto",
      direction: 'horizontal',
      loop: false,
      speed: 800,
      navigation: {
        nextEl: '#hardware-next',
        prevEl: '#hardware-prev',
      },
    });

    console.log('Hardware Swiper inicializado!');
  });
});
</script>



