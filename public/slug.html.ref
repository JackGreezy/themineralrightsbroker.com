<script src="/assets-f/js/77d22572600370.js"></script>

<script>
const lenis = new Lenis({
duration: 2,
easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // https://www.desmos.com/calculator/brs54l4xou
direction: 'vertical', // vertical, horizontal
gestureDirection: 'vertical', // vertical, horizontal, both
smooth: true,
mouseMultiplier: 1,
smoothTouch: false,
touchMultiplier: 2,
infinite: false,
})

//get scroll value
lenis.on('scroll', ({ scroll, limit, velocity, direction, progress }) => { console.log({ scroll, limit, velocity, direction, progress })
})

function raf(time) {
lenis.raf(time)
requestAnimationFrame(raf)
}

requestAnimationFrame(raf)
</script>

<!----------- Text split ----------------->

<script src="https://unpkg.com/split-type"></script>
<script src="/assets-f/js/7d9f56a3ed41c1.js"></script>
<script src="/assets-f/js/0e37abfac9f1bb.js"></script>

<script>
window.addEventListener("DOMContentLoaded", () => {
  let typeSplit = new SplitType("[text-split]", {
    types: "lines",
    tagName: "span"
  });

  function createScrollTrigger(triggerElement, timeline) {
    ScrollTrigger.create({
      trigger: triggerElement,
      start: "top 80%",
      once: true,
      onEnter: () => timeline.play()
    });
  }

  $("[words-slide-from-right]").each(function () {
    let tl = gsap.timeline({ paused: true });
    tl.from($(this).find(".line"), {
      opacity: 0,
      y: "0.5em",
      duration: 1.8,
      ease: "power2.out",
      stagger: { amount: 0.3 }
    });
    createScrollTrigger($(this), tl);
  });

  gsap.set("[text-split]", { opacity: 1 });
});
</script>


<!-- Gravitas countdown --> 
<script>
(function(){
  // March 1, 2026 — 12:00 PM in Torrance, California (PST, UTC-8)
  const target = new Date("2026-03-30T13:17:08Z").getTime();
  const el = document.getElementById("gravitas-countdown");

  function pad(n, d){ return String(n).padStart(d, "0"); }

  function update(){
    const now = Date.now();
    let diff = target - now;
    let sign = "T-";

    if(diff < 0){
      diff = Math.abs(diff);
      sign = "T+";
    }

    const totalSec = Math.floor(diff / 1000);
    const days = Math.floor(totalSec / 86400);
    const hours = Math.floor((totalSec % 86400) / 3600);
    const mins = Math.floor((totalSec % 3600) / 60);
    const secs = totalSec % 60;

    el.textContent = `${sign}${pad(days,3)}d ${pad(hours,2)}h ${pad(mins,2)}m ${pad(secs,2)}s / Gravitas`;
  }

  update();
  setInterval(update, 1000);
})();
</script>



