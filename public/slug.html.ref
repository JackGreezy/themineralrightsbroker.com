0, 0);transform:translate3d(0, 1rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" data-w-id="9ba9f371-bee9-cda4-03f1-c8d2fb954dc1" alt="" class="satelites-heading"><div data-w-id="7750a836-e173-6498-a026-075bc22aa744" style="-webkit-transform:translate3d(0, 5rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 5rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 5rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 5rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);opacity:0" class="satelites_tab-wrapper"><div class="tabs_menu hide-mobile-landscape"><a id="mega" data-w-id="b01a77a0-9c65-b43c-5100-ee3b92eb3b16" href="#" class="satelites_tab-nav-item is-mega w-inline-block"><div>Mega</div></a><a data-w-id="e6ae7359-2712-854a-609f-d445c26b5671" href="#" class="satelites_tab-nav-item is-giga w-inline-block"><div>Giga</div></a></div><div class="tabs_wrapper"><div class="tabs_pane"><div style="opacity:0" class="faq_group is-mega"><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Power</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>30kw of peak payload power</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Payload Mass</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>3,000 kg of available payload mass</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Payload Volume</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>3m x 2.7m payload deck to host the largest antennas and instruments</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Propulsion</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>20 kW hall effect thrusters to support rapid orbit raise (&lt; 3 months LEO to MEO) and station-keeping</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Thermal</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>Robust thermal control and significant dissipation to ensure stable operations over mission lifetime</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Avionics</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>Redundant computing, sensors, and control systems to maximize reliability</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Comms</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>High throughput with link margins support demanding missions</div></div><div class="spacer-small"></div></nav></div></div><div style="display:none;opacity:0" class="faq_group is-giga"><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Power</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>110 kW of array power for the most demanding space applications</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Payload Mass</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>15,000 kg available payload mass</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Payload Volume</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>Expanded 6.2m x 6.2m payload deck</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Propulsion</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>4- 20 kW hall effect thrusters for orbit transfer and station-keeping</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Thermal</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>30 kW+ heat rejection</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Avionics</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>Redundant computing, sensors, and control systems to maximize reliability</div></div><div class="spacer-small"></div></nav></div><div data-hover="false" data-delay="0" class="faq_item w-dropdown"><div class="faq_question w-dropdown-toggle"><div>Comms</div><img loading="lazy" src="/assets-f/img/6a4c8c98fffb39.svg" alt="" class="satelites_faq-icon"></div><nav class="faq_answer w-dropdown-list"><div class="faq_answer-block"><div>The highest throughput and link margins</div></div><div class="spacer-small"></div></nav></div></div></div><div class="tabs_menu show-landscape"><a id="mega-mobile" data-w-id="1070adc1-3484-88bb-4ecd-18dcfdbd2388" href="#" class="satelites_tab-nav-item is-mega w-inline-block"><div>Mega</div></a><a data-w-id="1070adc1-3484-88bb-4ecd-18dcfdbd238b" href="#" class="satelites_tab-nav-item is-giga w-inline-block"><div>Giga</div></a></div><div id="w-node-a47f9566-4fa6-b52f-55cf-ee4454f1b171-2b21940a" class="satelites_image-wrapper"><div data-w-id="af6a0524-7749-4fe2-d612-e844a291cc7b" style="opacity:1;-webkit-transform:translate3d(0, 0rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0rem, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" class="satelites_image-block-1"><img src="/assets-f/img/26060e81