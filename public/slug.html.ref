<!--- Next milestone -->
<div id="days"></div>

<script>
    const targetDate = new Date("2026-03-09T12:00:00Z");

    function updateCountdown() {
        const nowPTString = new Date().toLocaleString("en-US", {
            timeZone: "America/Los_Angeles"
        });
        const nowPT = new Date(nowPTString);

        const diffMs = targetDate - nowPT;
        const days = Math.floor(diffMs / (1000 * 60 * 60 * 24));

        const hours = String(nowPT.getHours()).padStart(2, "0");
        const minutes = String(nowPT.getMinutes()).padStart(2, "0");
        const seconds = String(nowPT.getSeconds()).padStart(2, "0");

        document.getElementById("days").innerHTML =
            `T-${days}D<br>${hours}:${minutes}:${seconds}`;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
</script>

