<script>
document.addEventListener("DOMContentLoaded", function () {
  const input = document.getElementById('password-input');
  const button = document.getElementById('password-button');
  const erro = document.querySelector('.error-msg');

  if (!input || !button || !erro) return;

  function validar() {
    if (input.value.trim() === "k2space") {
      window.location.href = "/portal";
    } else {
      erro.style.display = "block";
      input.focus();
    }
  }

  button.addEventListener('click', validar);

  input.addEventListener('input', function () {
    if (erro.style.display === "block") {
      erro.style.display = "none";
    }
  });

  // Opcional: permitir Enter para validar também
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      validar();
    }
  });
});
</script>
</body></html>