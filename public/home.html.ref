"https://cdn.prod.website-files.com/69333244a7b7aea22b21941a/69333244a7b7aea22b219514_Hero-compressed_webm.webm" data-wf-ignore="true"></video></div></div></section><section class="section_home-phrase"><div class="spacer-xxhuge is-larger"></div><div class="padding-global"><div class="container-large"><div class="home-phrase_component"><h2 words-slide-from-right="" text-split="" class="heading-style-h3" style="opacity: 1;"><span class="line" style="display: block; text-align: start; width: 100%; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;">Scale changes what’s possible. Bigger</span><span class="line" style="display: block; text-align: start; width: 100%; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;">satellites deliver more power to payloads,</span><span class="line" style="display: block; text-align: start; width: 100%; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;">mass on orbit, and resilience at lower</span><span class="line" style="display: block; text-align: start; width: 100%; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;">cost. Bigger isn’t excess, it’s access.</span></h2></div></div></div><div class="spacer-xxhuge is-larger"></div></section><section class="section_slider"><div class="padding-global"><div class="container-large"><div class="slider_component"><div class="slider_top"><h2 words-slide-from-right="" text-split="" class="heading-style-h3" style="opacity: 1;"><span class="line" style="display: block; text-align: start; width: 100%; translate: none; rotate: none; scale: none; transform: translate(0px, 0px); opacity: 1;"><strong style="display: inline-block; position: relative;">The frontier runs on hardware</strong></span></h2><div class="slider_controls-wrapper"><a id="hardware-prev" href="#" class="slider_controls w-inline-block swiper-button-disabled" tabindex="-1" role="button" 