<script>

// Function to sort select options alphabetically
function sortSelectOptions(selectId) {
    const select = document.getElementById(selectId);
    
    if (!select || select.options.length === 0) {
        return false;
    }
    
    // Get all options as an array
    const options = Array.from(select.options);
    
    // Sort options alphabetically by text (case-insensitive)
    options.sort((a, b) => {
        return a.text.localeCompare(b.text, undefined, { sensitivity: 'base' });
    });
    
    // Clear existing options
    select.innerHTML = '';
    
    // Re-append sorted options
    options.forEach(option => {
        select.appendChild(option);
    });
    
    // Trigger Select2 update if it's initialized
    if (window.jQuery && jQuery(select).data('select2')) {
        jQuery(select).trigger('change.select2');
    }
    
    return true;
}

// Lightweight observer - only watches, doesn't retry
function setupSelectSorter(selectId) {
    const select = document.getElementById(selectId);
    
    if (!select) {
        console.warn(`Select element with id "${selectId}" not found`);
        return;
    }
    
    // Setup MutationObserver to watch for options being added
    const observer = new MutationObserver((mutations) => {
        // Check if options were actually added
        const hasOptions = select.options.length > 0;
        
        if (hasOptions) {
            sortSelectOptions(selectId);
            observer.disconnect(); // Stop watching after first successful sort
        }
    });
    
    // Observe the select element
    observer.observe(select, {
        childList: true,
        subtree: false // Only watch direct children
    });
    
    // If options already exist, sort immediately and disconnect
    if (select.options.length > 0) {
        sortSelectOptions(selectId);
        observer.disconnect();
    }
}

// Initialize sorting for department filter
setupSelectSorter('department-filter');

</script>



<script src="/assets-f/js/d0dbfbc15eee93.js"></script>
<script src="/assets-f/js/2eddf4ae3c6234.js"></script>
<script defer="">
const BOARD = "k2spacecorporation";

/* ===============================
   SAFE PAGINATED JOB FETCH
================================ */
async function fetchAllJobs() {
    const allJobs = [];
    const seenIds = new Set();
    const MAX_PAGES = 50;

    for (let page = 1; page <= MAX_PAGES; page++) {
        const res = await fetch(
            `https://boards-api.greenhouse.io/v1/boards/${BOARD}/jobs?page=${page}`,
            { cache: "no-store" }
        );

        if (!res.ok) {
            throw new Error(`Jobs fetch failed on page ${page}`);
        }

        const jobs = (await res.json()).jobs || [];

        // Stop if API returns nothing
        if (jobs.length === 0) break;

        let newJobsAdded = 0;

        for (const job of jobs) {
            if (!seenIds.has(job.id)) {
                seenIds.add(job.id);
                allJobs.push(job);
                newJobsAdded++;
            }
        }

        // 🔒 CRITICAL STOP CONDITION
        if (newJobsAdded === 0) {
            console.warn("[Jobs] Pagination stopped — no new jobs detected");
            break;
        }
    }

    return allJobs;
}

/* ===============================
   DEPARTMENTS
================================ */
async function fetchDepartments() {
    const res = await fetch(
        `https://boards-api.greenhouse.io/v1/boards/${BOARD}/departments`,
        { cache: "no-store" }
    );

    if (!res.ok) throw new Error("Departments fetch failed");
    return (await res.json()).departments || [];
}

/* ===============================
   OFFICES
================================ */
async function fetchOffices() {
    try {
        const res = await fetch(
            `https://boards-api.greenhouse.io/v1/boards/${BOARD}/offices`,
            { cache: "no-store" }
        );

        if (!res.ok) {
            console.warn("[Jobs] Offices fetch failed:", res.status, res.statusText);
            return [];
        }
        return (await res.json()).offices || [];
    } catch (err) {
        console.warn("[Jobs] Offices fetch error:", err);
        return [];
    }
}

/* ===============================
   RENDERING
================================ */
function renderJob(job) {
    const el = document.createElement("div");
    el.className = "job-item";
    el.onclick = () => window.open(job.absolute_url, "_blank");

    el.innerHTML = `
        <div class="job-title">${job.title.trim()}</div>
        <div class="job-location">${job.location?.name || "Location not specified"}</div>
    `;

    return el;
}

function renderDepartment(name, jobs) {
    if (!jobs.length) return null;

    const section = document.createElement("div");
    section.className = "category-section";

    const heading = document.createElement("h2");
    heading.className = "category-heading";
    heading.textContent = name;

    section.appendChild(heading);
    
    const headingDivider = document.createElement("div");
    headingDivider.className = "divider";
    section.appendChild(headingDivider);

    jobs.forEach((job, index) => {
        section.appendChild(renderJob(job));
        
        // Add divider after each job (except the last one)
        if (index < jobs.length - 1) {
            const divider = document.createElement("div");
            divider.className = "divider";
            section.appendChild(divider);
        }
    });

    return section;
}

/* ===============================
   FILTERING & SEARCH
================================ */
let allJobs = [];
let allGrouped = {};
let departments = [];

function extractOfficesFromJobs(jobs) {
    const officesSet = new Set();
    jobs.forEach(job => {
        if (job.location && job.location.name) {
            officesSet.add(job.location.name);
        }
    });
    return Array.from(officesSet).sort();
}

function populateFilters(departmentsFromJobs, officesFromJobs) {
    const deptSelect = document.getElementById("department-filter");
    const officeSelect = document.getElementById("office-filter");

    // Clear existing options (no "Select..." option)
    deptSelect.innerHTML = '';
    officeSelect.innerHTML = '';

    // Populate Department filter - only departments that have jobs
    departmentsFromJobs.forEach(dept => {
        const option = document.createElement("option");
        option.value = dept;
        option.textContent = dept;
        option.style.backgroundColor = '#000000';
        option.style.color = '#e0e0e0';
        deptSelect.appendChild(option);
    });

    // Populate Office filter from job locations
    officesFromJobs.forEach(office => {
        const option = document.createElement("option");
        option.value = office;
        option.textContent = office;
        option.style.backgroundColor = '#000000';
        option.style.color = '#e0e0e0';
        officeSelect.appendChild(option);
    });

    // Apply custom styling after options are added
    setTimeout(() => {
        applySelectStyling();
        attachSelectEventListeners();
        initializeSelect2();
    }, 100);
}

function initializeSelect2() {
    // Initialize Select2 on all filter selects with custom theme
    if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
        // Destroy existing Select2 instances if any
        jQuery('.filter-select').each(function() {
            if (jQuery(this).hasClass('select2-hidden-accessible')) {
                jQuery(this).select2('destroy');
            }
        });

        jQuery('.filter-select').select2({
            theme: 'default',
            dropdownCssClass: 'custom-select2-dropdown',
            minimumResultsForSearch: Infinity, // Disable search
            width: '100%',
            placeholder: {
                id: null,
                text: 'Select...'
            },
            allowClear: false // We'll handle clearing manually with cross icon
        });
        
        // Ensure no option is selected by default
        jQuery('.filter-select').val(null).trigger('change.select2');

        // Add cross icon and handle clearing
        jQuery('#department-filter, #office-filter').each(function() {
            const $select = jQuery(this);
            
            // Function to update cross icon visibility
            function updateClearButton() {
                const $container = $select.next('.select2-container');
                const $selection = $container.find('.select2-selection');
                const $rendered = $selection.find('.select2-selection__rendered');
                let $clearBtn = $selection.find('.select2-clear-btn');
                
                // Check if a real option is selected (not placeholder)
                const selectedValue = $select.val();
                const selectedData = $select.select2('data');
                const renderedText = $rendered.text().trim();
                
                // Check if we're in placeholder state - if value is null/empty, definitely hide cross icon
                const isPlaceholder = !selectedValue || 
                                     selectedValue === '' || 
                                     selectedValue === null ||
                                     selectedValue === undefined ||
                                     (selectedData && selectedData.length > 0 && selectedData[0].id === null) ||
                                     renderedText === 'Select...' ||
                                     renderedText === '';
                
                // If filter is cleared/empty, hide cross icon immediately
                if (isPlaceholder) {
                    if ($clearBtn.length > 0) {
                        // Use multiple methods to ensure it's hidden
                        $clearBtn[0].style.setProperty('display', 'none', 'important');
                        $clearBtn[0].style.setProperty('visibility', 'hidden', 'important');
                        $clearBtn[0].style.setProperty('opacity', '0', 'important');
                        $clearBtn.hide();
                        $clearBtn.addClass('select2-clear-btn-hidden');
                        $clearBtn.removeClass('select2-clear-btn-visible');
                    }
                    return; // Exit early, no need to show cross icon
                }
                
                // Only show cross icon if a real value is selected
                if (selectedValue) {
                    // Real value is selected, show cross icon
                    if ($clearBtn.length === 0) {
                        $clearBtn = jQuery('<span class="select2-clear-btn">×</span>');
                        $selection.append($clearBtn);
                        
                        // Handle cross click
                        $clearBtn.on('click', function(e) {
                            e.stopPropagation();
                            e.preventDefault();
                            // Clear the value
                            $select.val(null).trigger('change.select2');
                            // Immediately hide the cross icon using inline style with !important
                            if ($clearBtn.length > 0 && $clearBtn[0]) {
                                $clearBtn[0].style.setProperty('display', 'none', 'important');
                                $clearBtn[0].style.setProperty('visibility', 'hidden', 'important');
                                $clearBtn[0].style.setProperty('opacity', '0', 'important');
                            }
                            $clearBtn.hide();
                            $clearBtn.addClass('select2-clear-btn-hidden');
                            $clearBtn.removeClass('select2-clear-btn-visible');
                            // Update button state after a short delay to ensure Select2 updates
                            setTimeout(function() {
                                updateClearButton();
                            }, 50);
                            filterJobs();
                        });
                    }
                    // Show cross icon and add visible class
                    if ($clearBtn.length > 0 && $clearBtn[0]) {
                        $clearBtn[0].style.setProperty('display', 'flex', 'important');
                        $clearBtn[0].style.setProperty('visibility', 'visible', 'important');
                        $clearBtn[0].style.setProperty('opacity', '1', 'important');
                    }
                    $clearBtn.show();
                    $clearBtn.addClass('select2-clear-btn-visible');
                    $clearBtn.removeClass('select2-clear-btn-hidden');
                }
            }
            
            // Update on selection change
            $select.on('select2:select', function() {
                setTimeout(updateClearButton, 10);
                filterJobs();
            });
            
            $select.on('select2:clear', function() {
                // Immediately hide cross icon when cleared
                const $container = $select.next('.select2-container');
                const $selection = $container.find('.select2-selection');
                const $clearBtn = $selection.find('.select2-clear-btn');
                if ($clearBtn.length > 0 && $clearBtn[0]) {
                    // Use inline style with !important to ensure it's hidden
                    $clearBtn[0].style.setProperty('display', 'none', 'important');
                    $clearBtn[0].style.setProperty('visibility', 'hidden', 'important');
                    $clearBtn[0].style.setProperty('opacity', '0', 'important');
                    $clearBtn.hide();
                    $clearBtn.addClass('select2-clear-btn-hidden');
                    $clearBtn.removeClass('select2-clear-btn-visible');
                }
                setTimeout(updateClearButton, 10);
                filterJobs();
            });
            
            // Also update when dropdown closes (in case selection changed)
            $select.on('select2:close', function() {
                setTimeout(updateClearButton, 10);
            });
            
            // Update when Select2 is opened (to ensure correct state)
            $select.on('select2:open', function() {
                setTimeout(updateClearButton, 10);
            });
            
            // Initial update - ensure no value is selected and placeholder shows
            setTimeout(function() {
                if (!$select.val() || $select.val() === '') {
                    $select.val(null).trigger('change.select2');
                }
                updateClearButton();
            }, 200);
        });

        // Apply custom CSS after Select2 initialization
        let select2Style = document.getElementById('select2-custom-styles');
        if (!select2Style) {
            select2Style = document.createElement('style');
            select2Style.id = 'select2-custom-styles';
            document.head.appendChild(select2Style);
        }
        
        select2Style.textContent = `
            /* Fix scroll issue and Webflow conflicts */
            .select2-container--default .select2-results {
                max-height: 300px !important;
                font-size: 14px !important;
                pointer-events: auto !important;
                touch-action: pan-y !important;
                scroll-behavior: smooth !important;
            }
            .select2-dropdown {
                background-color: #000000 !important;
                border: 1px solid #333333 !important;
                max-height: 300px !important;
                overflow-y: auto !important;
                overflow-x: hidden !important;
                font-size: 14px !important;
                pointer-events: auto !important;
                touch-action: pan-y !important;
            }
            /* Custom scrollbar for better visibility */
            .select2-container--default .select2-results::-webkit-scrollbar {
                width: 8px !important;
                display: block !important;
            }
            .select2-container--default .select2-results::-webkit-scrollbar-track {
                background: #1a1a1a !important;
            }
            .select2-container--default .select2-results::-webkit-scrollbar-thumb {
                background: #7C7C7C !important;
                border-radius: 4px !important;
            }
            .select2-container--default .select2-results::-webkit-scrollbar-thumb:hover {
                background: #999999 !important;
            }
            .select2-container--default .select2-results__option {
                background-color: #000000 !important;
                color: #e0e0e0 !important;
                font-size: 14px !important;
                font-family: inherit !important;
            }
            .select2-container--default .select2-results__option--highlighted[aria-selected],
            .select2-container--default .select2-results__option[aria-selected=true],
            .select2-container--default .select2-results__option:hover,
            .select2-container--default .select2-results__option--highlighted {
                background-color: #7C7C7C !important;
                background: #7C7C7C !important;
                color: #fff !important;
                font-size: 14px !important;
            }
            .select2-container--default .select2-selection--single {
                background-color: #000000 !important;
                border: none !important;
                height: auto !important;
                font-size: 14px !important;
                position: relative !important;
            }
            .select2-container--default .select2-selection--single .select2-selection__rendered {
                color: #999999 !important;
                line-height: normal !important;
                font-size: 14px !important;
                padding-right: 25px !important;
            }
            .select2-container--default .select2-selection--single .select2-selection__placeholder {
                color: #999999 !important;
            }
            /* Cross icon styling */
            .select2-selection {
                position: relative !important;
            }
            .select2-clear-btn {
                position: absolute !important;
                right: 25px !important;
                top: 50% !important;
                transform: translateY(-50%) !important;
                cursor: pointer !important;
                color: #CBCBCB !important;
                font-size: 20px !important;
                line-height: 1 !important;
                width: 18px !important;
                height: 18px !important;
                display: flex !important;
                align-items: center !important;
                justify-content: center !important;
                z-index: 10 !important;
                transition: color 0.2s ease !important;
                pointer-events: auto !important;
            }
            .select2-clear-btn:hover {
                color: #ffffff !important;
            }
            /* Hide cross icon when filter is cleared - using !important to override any other styles */
            .select2-clear-btn-hidden,
            .select2-selection .select2-clear-btn-hidden {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
                pointer-events: none !important;
            }
            .select2-clear-btn-visible,
            .select2-selection .select2-clear-btn-visible {
                display: flex !important;
                visibility: visible !important;
                opacity: 1 !important;
                pointer-events: auto !important;
            }
            /* Prevent Webflow from overriding */
            .select2-container,
            .select2-container *,
            .select2-dropdown * {
                font-size: 14px !important;
            }
        `;
    }
}

function setupFilterEventListeners() {
    // Search input
    const searchInput = document.getElementById("search-input");
    if (searchInput) {
        searchInput.addEventListener("input", filterJobs);
    }

    // If Select2 is not available, use native event listeners
    if (typeof jQuery === 'undefined' || !jQuery.fn.select2) {
        const deptFilter = document.getElementById("department-filter");
        const officeFilter = document.getElementById("office-filter");
        
        if (deptFilter) deptFilter.addEventListener("change", filterJobs);
        if (officeFilter) officeFilter.addEventListener("change", filterJobs);
    }
    // If Select2 is available, events are attached in initializeSelect2()
}

function attachSelectEventListeners() {
    // Attach event listeners to all select filters
    const selects = document.querySelectorAll('.filter-select');
    selects.forEach(select => {
        // Remove any existing listeners
        const newSelect = select.cloneNode(true);
        select.parentNode.replaceChild(newSelect, select);
        
        // Add focus/click listeners to apply styling
        newSelect.addEventListener('focus', () => {
            applySelectStyling();
        });
        newSelect.addEventListener('click', () => {
            setTimeout(applySelectStyling, 50);
        });
        newSelect.addEventListener('mousedown', () => {
            setTimeout(applySelectStyling, 50);
        });
    });
}

function applySelectStyling() {
    // Remove existing dynamic styles
    const existing = document.getElementById('dynamic-select-styles');
    if (existing) existing.remove();

    // Add style tag with dynamic CSS
    const style = document.createElement('style');
    style.id = 'dynamic-select-styles';
    style.textContent = `
        /* Native Select Options - Override Browser Defaults */
        select.filter-select option {
            background-color: #000000 !important;
            background: #000000 !important;
            color: #e0e0e0 !important;
        }
        select.filter-select option:hover,
        select.filter-select option:checked,
        select.filter-select option:focus,
        select.filter-select option:active,
        select.filter-select option[selected] {
            background-color: #7C7C7C !important;
            background: #7C7C7C !important;
            color: #fff !important;
        }
        /* Force override for all states */
        select#department-filter option:hover,
        select#office-filter option:hover {
            background: #7C7C7C !important;
            background-color: #7C7C7C !important;
            color: #fff !important;
        }
        select#department-filter option:checked,
        select#office-filter option:checked {
            background: #7C7C7C !important;
            background-color: #7C7C7C !important;
            color: #fff !important;
        }
        /* Select2 Styling */
        .select2-container--default .select2-results__option {
            background-color: #000000 !important;
            color: #e0e0e0 !important;
        }
        .select2-container--default .select2-results__option--highlighted,
        .select2-container--default .select2-results__option[aria-selected=true],
        .select2-container--default .select2-results__option:hover,
        .select2-container--default .select2-results__option--highlighted[aria-selected] {
            background-color: #7C7C7C !important;
            background: #7C7C7C !important;
            color: #fff !important;
        }
    `;
    document.head.appendChild(style);

    // Also apply inline styles to all existing options
    document.querySelectorAll('.filter-select option').forEach(option => {
        if (option.value) {
            option.style.backgroundColor = '#000000';
            option.style.color = '#e0e0e0';
        }
    });
}

// Create jobToDept map once
let jobToDeptMap = new Map();

function filterJobs() {
    const searchTerm = document.getElementById("search-input").value.toLowerCase().trim();
    
    // Get values - handle both native select and Select2
    let selectedDept, selectedOffice;
    
    if (typeof jQuery !== 'undefined' && jQuery.fn.select2) {
        // If Select2 is initialized, use jQuery to get values
        selectedDept = jQuery('#department-filter').val() || '';
        selectedOffice = jQuery('#office-filter').val() || '';
    } else {
        // Native select values
        selectedDept = document.getElementById("department-filter").value;
        selectedOffice = document.getElementById("office-filter").value;
    }

    const filteredJobs = allJobs.filter(job => {
        // Search filter
        if (searchTerm && !job.title.toLowerCase().includes(searchTerm)) {
            return false;
        }

        // Department filter - use jobToDeptMap
        if (selectedDept) {
            const jobDept = jobToDeptMap.get(job.id) || "Other";
            if (jobDept !== selectedDept) {
                return false;
            }
        }

        // Office filter - use job.location.name
        if (selectedOffice) {
            const jobLocation = job.location?.name || "";
            if (jobLocation !== selectedOffice) {
                return false;
            }
        }

        return true;
    });

    // Re-group filtered jobs
    const filteredGrouped = {};
    filteredJobs.forEach(job => {
        const dept = jobToDeptMap.get(job.id) || "Other";
        filteredGrouped[dept] ??= [];
        filteredGrouped[dept].push(job);
    });

    Object.values(filteredGrouped).forEach(list =>
        list.sort((a, b) => a.title.localeCompare(b.title))
    );

    // Render filtered results
    renderJobs(filteredGrouped, filteredJobs.length);
}

function renderJobs(grouped, totalCount) {
    const container = document.getElementById("jobs-container");
    container.innerHTML = "";

    const total = document.createElement("div");
    total.className = "total-jobs";
    total.textContent = `${totalCount} jobs`;
    container.appendChild(total);

    Object.keys(grouped)
        .sort((a, b) => {
            if (a === "Engineering") return -1;
            if (b === "Engineering") return 1;
            if (a === "Avionics") return -1;
            if (b === "Avionics") return 1;
            return a.localeCompare(b);
        })
        .forEach(dept => {
            const section = renderDepartment(dept, grouped[dept]);
            if (section) container.appendChild(section);
        });
}

/* ===============================
   MAIN
================================ */
async function loadJobs() {
    const container = document.getElementById("jobs-container");
    if (!container) return;

    container.innerHTML = `<p style="color:#999;">Loading all roles…</p>`;

    try {
        // Fetch critical data first
        const [jobs, depts] = await Promise.all([
            fetchAllJobs(),
            fetchDepartments()
        ]);

        allJobs = jobs;
        departments = depts;

        console.log("[Jobs] Total unique jobs:", jobs.length);
        console.log("[Jobs] Departments:", depts.length);

        // Build job to department mapping
        jobToDeptMap = new Map();
        departments.forEach(dept => {
            dept.jobs?.forEach(job => {
                jobToDeptMap.set(job.id, dept.name);
            });
        });

        const grouped = {};
        jobs.forEach(job => {
            const dept = jobToDeptMap.get(job.id) || "Other";
            grouped[dept] ??= [];
            grouped[dept].push(job);
        });

        allGrouped = grouped;

        Object.values(grouped).forEach(list =>
            list.sort((a, b) => a.title.localeCompare(b.title))
        );

        // Extract offices from jobs (job.location.name)
        const officesFromJobs = extractOfficesFromJobs(jobs);

        // Extract departments from jobs (only departments that have jobs)
        const departmentsFromJobs = Object.keys(grouped).sort((a, b) => {
            if (a === "Engineering") return -1;
            if (b === "Engineering") return 1;
            if (a === "Avionics") return -1;
            if (b === "Avionics") return 1;
            return a.localeCompare(b);
        });

        // Populate filter dropdowns - use departments from jobs, not API
        populateFilters(departmentsFromJobs, officesFromJobs);

        // Set up event listeners for filters
        setupFilterEventListeners();

        // Initial render
        renderJobs(grouped, jobs.length);

    } catch (err) {
        console.error("[Jobs] Error loading jobs:", err);
        container.innerHTML = `
            <p style="color:#ff4444;">Couldn't load jobs.</p>
            <p style="color:#999; font-size:12px; margin-top:10px;">
                Error: ${err.message || 'Unknown error'}<br>
                Check console for details.
            </p>
        `;
    }
}

document.addEventListener("DOMContentLoaded", loadJobs);
lenis.destroy();







// Function to sort select options alphabetically
function sortSelectOptions(selectId) {
    const select = document.getElementById(selectId);
    
    if (!select) {
        console.warn(`Select element with id "${selectId}" not found`);
        return;
    }
    
    // Get all options as an array
    const options = Array.from(select.options);
    
    // Sort options alphabetically by text (case-insensitive)
    options.sort((a, b) => {
        return a.text.localeCompare(b.text, undefined, { sensitivity: 'base' });
    });
    
    // Clear existing options
    select.innerHTML = '';
    
    // Re-append sorted options
    options.forEach(option => {
        select.appendChild(option);
    });
    
    // Trigger Select2 update if it's initialized
    if (window.jQuery && jQuery(select).data('select2')) {
        jQuery(select).trigger('change.select2');
    }
}

</script></body></html>