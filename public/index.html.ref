        /* All Select Filters - Remove Blue Color on Hover/Active - Webflow Safe */
        .filter-select option:hover,
        .filter-select option:checked,
        .filter-select option:focus,
        .filter-select option:active,
        .filter-select option[selected],
        .filter-select option[value]:hover {
            background-color: #7C7C7C !important;
            background: #7C7C7C !important;
            color: #fff !important;
            font-size: 14px !important;
        }

        /* Override browser default blue */
        .filter-select:focus option:checked,
        .filter-select:focus option:hover {
            background-color: #7C7C7C !important;
            background: #7C7C7C !important;
            color: #fff !important;
        }

        /* Prevent Webflow from overriding filter font sizes */
        .filter-select,
        .filter-select option,
        .filter-input {
            font-size: 14px !important;
            font-family: inherit !important;
        }

        /* Select2 Dropdown - All Filters Custom Styling - Webflow Safe */
        .select2-container--default .select2-results__option--highlighted[aria-selected],
        .select2-container--default .select2-results__option[aria-selected=true],
        .select2-container--default .select2-results__option:hover,
        .select2-container--default .select2-results__option[data-selected=true],
        .select2-container--default .select2-results__option--highlighted {
            background-color: #7C7C7C !important;
            color: #fff !important;
            font-size: 14px !important;
        }

        /* Select2 dropdown container styling - Webflow Safe */
        .select2-container--default .select2-results__option {
            background-color: #000000 !important;
            color: #e0e0e0 !important;
            font-size: 14px !important;
        }

        /* Select2 dropdown - Fix scroll and Webflow conflicts */
        .select2-dropdown {
            background-color: #000000 !important;
            border: 1px solid #333333 !important;
            max-height: 300px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            font-size: 14px !important;
            pointer-events: auto !important;
            touch-action: pan-y !important;
        }

        /* Select2 results container - Fix scroll */
        .select2-container--default .select2-results {
            max-height: 300px !important;
            
            font-size: 14px !important;
            pointer-events: auto !important;
            touch-action: pan-y !important;
            scroll-behavior: smooth !important;
        }

        /* Ensure scrollbar is visible and functional */
        .select2-container--default .select2-results::-webkit-scrollbar {
            width: 8px !important;
            display: block !important;
        }

        .select2-container--default .select2-results::-webkit-scrollbar-track {
            background: #1a1a1a !important;
        }

        .select2-container--default .select2-results::-webkit-scrollbar-thumb {
            background: #7C7C7C !important;
            border-radius: 4px !important;
        }

        .select2-container--default .select2-results::-webkit-scrollbar-thumb:hover {
            background: #999999 !important;
        }

        /* Override any blue colors */
        .select2-container--default .select2-results__option[aria-selected]:hover,
        .select2-container--default .select2-results__option[aria-selected]:focus {
            background-color: #7C7C7C !important;
            color: #fff !important;
        }

        /* Prevent Webflow from overriding font sizes - Isolated scope */
        #jobs-listing-container .select2-container,
        #jobs-listing-container .select2-container *,
        #jobs-listing-container .select2-dropdown,
        #jobs-listing-container .select2-dropdown *,
        #jobs-listing-container .filter-select,
        #jobs-listing-container .filter-select option,
        #jobs-listing-container .filter-input {
            font-size: 14px !important;
            font-family: inherit !important;
        }

        /* Isolate from Webflow body styles */
        #jobs-listing-container {
            font-size: 14px !important;
        }
        
        #jobs-listing-container * {
            box-sizing: border-box;
        }

        /* Native select dropdown styling - Most Aggressive */
        /* color-scheme: dark; - Removed for Webflow compatibility */

        select.filter-select option,
        select#department-filter option,
        select#office-filter option,
        select#employment-type-filter option {
            background-color: #000000 !important;
            background: #000000 !important;
            color: #e0e0e0 !important;
        }

        select.filter-select option:hover,
        select.filter-select option:checked,
        select.filter-select option:focus,
        select#department-filter option:hover,
        select#department-filter option:checked,
        select#office-filter option:hover,
        select#office-filter option:checked,
        select#employment-type-filter option:hover,
        select#employment-type-filter option:checked {
            background-color: #7C7C7C !important;
            background: #7C7C7C !important;
            color: #fff !important;
        }

        /* Override any browser default blue - Most Aggressive */
        * {
            --select-option-hover-bg: #7C7C7C !important;
            --select-option-selected-bg: #7C7C7C !important;
        }

        /* Force dark theme for all selects */
        select.filter-select {
            /* color-scheme: dark; - Removed for Webflow compatibility */
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
        }

        /* Additional override for WebKit browsers */
        select.filter-select::-webkit-list-button,
        select.filter-select::-webkit-dropdown-list-box {
            background-color: #000000 !important;
        }

        /* For Firefox */
        select.filter-select option {
            -moz-appearance: none !important;
            appearance: none !important;
        }
@media (max-width: 767px) {

    .filter-group {
        flex: 0 0 calc(50% - 8px); /* 2 items per row */
        min-width: unset;
    }

    .filter-group:nth-child(3) {
        flex: 0 0 100%; /* 3rd item full width */
    }
    .filter-label{
    font-size:12px;}
.filter-group{
min-height:52px ;
