<script>
window.addEventListener("DOMContentLoaded", () => {
  let typeSplit = new SplitType("[text-split]", {
    types: "lines",
    tagName: "span"
  });

  function createScrollTrigger(triggerElement, timeline) {
    ScrollTrigger.create({
      trigger: triggerElement,
      start: "top 80%",
      once: true,
      onEnter: () => timeline.play()
    });
  }

  $("[words-slide-from-right]").each(function () {
    let tl = gsap.timeline({ paused: true });
    tl.from($(this).find(".line"), {
      opacity: 0,
      y: "0.5em",
      duration: 1.8,
      ease: "power2.out",
      stagger: { amount: 0.3 }
    });
    createScrollTrigger($(this), tl);
  });

  gsap.set("[text-split]", { opacity: 1 });
});
</script>


<!-- Gravitas countdown --> 
<script>
(function(){
  // March 1, 2026 — 12:00 PM in Torrance, California (PST, UTC-8)
  const target = new Date("2026-03-30T13:17:08Z").getTime();
  const el = document.getElementById("gravitas-countdown");

  function pad(n, d){ return String(n).padStart(d, "0"); }

  function update(){
    const now = Date.now();
    let diff = target - now;
    let sign = "T-";

    if(diff < 0){
      diff = Math.abs(diff);
      sign = "T+";
    }

    const totalSec = Math.floor(diff / 1000);
    const days = Math.floor(totalSec / 86400);
    const hours = Math.floor((totalSec % 86400) / 3600);
    const mins = Math.floor((totalSec % 3600) / 60);
    const secs = totalSec % 60;

    el.textContent = `${sign}${pad(days,3)}d ${pad(hours,2)}h ${pad(mins,2)}m ${pad(secs,2)}s / Gravitas`;
  }

  update();
  setInterval(update, 1000);
})();
</script>



